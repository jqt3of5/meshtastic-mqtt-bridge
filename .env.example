# MQTT broker connection
MQTT_BROKER_URL=mqtt://mqtt.meshtastic.org:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=msh/+/+/+

# Meshtastic mesh encryption key (base64)
MESH_ENCRYPTION_KEY=AQ==

# InfluxDB connection (INFLUXDB_TOKEN is required)
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=
INFLUXDB_ORG=meshtastic
INFLUXDB_BUCKET=meshtastic

# Kafka (optional — omit KAFKA_BROKERS to disable)
# KAFKA_BROKERS=localhost:9092
# KAFKA_TOPIC=meshtastic.packets
# KAFKA_CLIENT_ID=meshtastic-mqtt-bridge
# KAFKA_COMPRESSION=gzip
# KAFKA_SSL=false
# KAFKA_SASL_MECHANISM=plain
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# Logging
LOG_LEVEL=info
